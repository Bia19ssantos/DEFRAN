table {
    width: 100%;
    border-collapse: collapse; /* Combine adjacent table borders */
}

th, td {
    border: 1px solid white; /* Add a white border to table cells */
    padding: 8px; /* Add padding to the cells for better spacing */
}

th {
    background-color: black;
    color: white;
}

/* Optional: Style for alternating row colors */
tr:nth-child(even) {
    background-color: #d7d7d7;
}

