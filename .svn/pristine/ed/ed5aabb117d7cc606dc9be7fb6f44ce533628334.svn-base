DROP TABLE IF EXISTS `prod_pewag`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `prod_pewag` (
  `id` int NOT NULL AUTO_INCREMENT,
  `codigo` varchar(50) DEFAULT NULL,
  `ref_gunnebo` varchar(50) DEFAULT NULL,
  `ref_pewag` varchar(50) DEFAULT NULL,
  `desc_prod` varchar(255) DEFAULT NULL,
  `ncm` varchar(10) DEFAULT NULL,
  `icms` decimal(8,4) DEFAULT NULL,
  `ipi` decimal(8,4) DEFAULT NULL,
  `tipo` varchar(50) DEFAULT NULL,
  `valor_custo` decimal(10,2) DEFAULT NULL,
  `valor_venda` decimal(10,2) DEFAULT NULL,
  `comprimento` decimal(8,2) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=334 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
