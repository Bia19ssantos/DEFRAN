DROP TABLE IF EXISTS `prod_gunnebo`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `prod_gunnebo` (
  `id` int NOT NULL AUTO_INCREMENT,
  `ref_prod` varchar(100) DEFAULT NULL,
  `desc_prod` varchar(1000) DEFAULT NULL,
  `ncm` varchar(10) DEFAULT NULL,
  `sap` varchar(20) DEFAULT NULL,
  `ipi` decimal(8,4) DEFAULT NULL,
  `tipo` varchar(10) DEFAULT NULL,
  `valor_custo` decimal(8,2) DEFAULT NULL,
  `comprimento` decimal(8,2) DEFAULT NULL,
  `valor_venda` decimal(8,2) DEFAULT NULL,
  `preco_linga` decimal(8,2) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=451 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
